@page
@{
    ViewData["Title"] = "Administration";
}

<header class="page-heading">
    <p class="page-kicker">Administrator tools</p>
    <h1>@ViewData["Title"]</h1>
    <p class="page-intro">Manage access to THRIFTLU Staff tools.</p>
</header>
<section class="form-panel form-page" aria-labelledby="staff-access-heading">
    <h2 id="staff-access-heading" class="h4">Staff access</h2>
    <p>Find an existing account and grant or remove Staff membership. Student membership is preserved.</p>
    <a asp-page="/Admin/Users/Index" class="btn btn-primary">Manage Staff access</a>
</section>
<p class="form-note mt-4">Store settings and other account administration are not available here.</p>
<a asp-area="" asp-page="/Index">Return to home</a>

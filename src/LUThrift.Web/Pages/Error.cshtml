@page
@model ErrorModel
@{
    Layout = "_ErrorLayout";
    ViewData["Title"] = "Something went wrong";
}

<h1>Something went wrong</h1>
<p>We couldn't complete your request. Please try again in a moment.</p>
<p>If you submitted a change, check its current status before trying again.</p>
<p>If the problem continues, share this request reference with the LU Thrift team:</p>
<p class="request-reference"><strong>Request reference:</strong> <code class="text-break">@Model.RequestId</code></p>
<nav aria-label="Error page navigation" class="form-actions">
    <a class="btn btn-primary" asp-page="/Thrift/Index">Browse items</a>
    <a class="btn btn-outline-secondary" asp-page="/Index">Go to home</a>
</nav>

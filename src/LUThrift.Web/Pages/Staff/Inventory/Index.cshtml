@page
@model LUThrift.Web.Pages.Staff.Inventory.IndexModel
@using System.Globalization
@using LUThrift.Web.Models
@using LUThrift.Web.Services
@{
    ViewData["Title"] = "Inventory";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>
    <a asp-page="./Create" class="btn btn-primary">Create listing</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.InventoryMessage))
{
    <div class="alert alert-success" role="status">@Model.InventoryMessage</div>
}
@if (!string.IsNullOrWhiteSpace(Model.InventoryError))
{
    <div class="alert alert-danger" role="alert">@Model.InventoryError</div>
}

<form method="get" asp-page="/Staff/Inventory/Index" class="row g-2 align-items-end mb-4">
    <div class="col-sm-6 col-md-4">
        <label asp-for="Status" class="form-label">Status</label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<ListingStatus>()" class="form-select">
            <option value="">All statuses</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="/Staff/Inventory/Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

@if (!Model.HasInventory)
{
    <p>No inventory listings yet.</p>
}
else if (Model.Listings.Count == 0)
{
    <p>No listings match this status.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <caption class="caption-top">Inventory listings, newest first.</caption>
            <thead>
                <tr>
                    <th scope="col">Title</th>
                    <th scope="col">Category</th>
                    <th scope="col">Condition</th>
                    <th scope="col">Size</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created (UTC)</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var listing in Model.Listings)
                {
                    var createdAtUtc = DateTime.SpecifyKind(listing.CreatedAtUtc, DateTimeKind.Utc);
                    <tr>
                        <th scope="row">
                            <div class="d-flex align-items-center gap-2">
                                <img src="~/images/listing-placeholder.svg" alt="No image available" width="64" height="64" />
                                <span class="text-break">@listing.Title</span>
                            </div>
                        </th>
                        <td>@listing.Category.Name</td>
                        <td>@listing.Condition</td>
                        <td>@(listing.Size ?? "Not specified")</td>
                        <td>@listing.Status</td>
                        <td>
                            <time datetime="@createdAtUtc.ToString("O", CultureInfo.InvariantCulture)">@createdAtUtc.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</time>
                        </td>
                        <td>
                            <div class="d-flex flex-wrap gap-2">
                                @if (ListingService.IsEditable(listing.Status))
                                {
                                    <a asp-page="./Edit" asp-route-id="@listing.Id"
                                       class="btn btn-sm btn-outline-primary" aria-label="Edit @listing.Title">Edit</a>
                                }
                                else
                                {
                                    <span class="text-muted">Not editable</span>
                                }
                                @if (ListingService.CanPublish(listing.Status))
                                {
                                    <form method="post" asp-page="./Index" asp-page-handler="Publish"
                                          asp-route-id="@listing.Id" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-primary"
                                                aria-label="Publish @listing.Title">Publish</button>
                                    </form>
                                }
                                @if (ListingService.CanArchive(listing.Status))
                                {
                                    <form method="post" asp-page="./Index" asp-page-handler="Archive"
                                          asp-route-id="@listing.Id" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                aria-label="Archive @listing.Title">Archive</button>
                                    </form>
                                }
                                @if (ListingService.CanMarkMissing(listing.Status))
                                {
                                    <form method="post" asp-page="./Index" asp-page-handler="MarkMissing"
                                          asp-route-id="@listing.Id" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                aria-label="Mark @listing.Title as missing">Mark missing</button>
                                    </form>
                                }
                                @if (ListingService.CanRecordWalkInCollection(listing.Status))
                                {
                                    <form method="post" asp-page="./Index" asp-page-handler="RecordWalkInCollection"
                                          asp-route-id="@listing.Id" asp-antiforgery="true">
                                        <button type="submit" class="btn btn-sm btn-outline-success"
                                                aria-label="Record walk-in collection for @listing.Title">Record walk-in collection</button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@page "{id:int}"
@model LUThrift.Web.Pages.Thrift.DetailsModel
@using LUThrift.Web.Models
@{
    var listing = Model.Listing;
    ViewData["Title"] = listing.Title;
    var statusLabel = listing.Status == ListingStatus.Held ? "Reserved" : "Available";
}

<div class="item-details-page">
<a asp-page="./Index" asp-all-route-data="Model.CatalogRouteValues" class="catalog-back-link">Back to catalog</a>
<header class="page-heading">
    <h1 class="text-break">@listing.Title</h1>
</header>

<div class="item-detail-layout">
    <div class="item-detail-media">
        @if (listing.HasImage)
        {
            <img src="@Url.Page("/Thrift/Image", new { id = listing.Id })" alt="Photo of @listing.Title" class="listing-photo" />
        }
        else
        {
            <img src="~/images/listing-placeholder.svg" alt="No image available" width="192" height="192" class="listing-placeholder" />
        }
    </div>
    <div class="item-detail-information">
        <dl class="listing-facts item-detail-facts">
            <div>
                <dt>Category</dt>
                <dd class="text-break">@listing.CategoryName</dd>
            </div>
            <div>
                <dt>Condition</dt>
                <dd class="text-break">@listing.Condition</dd>
            </div>
            <div>
                <dt>Size</dt>
                <dd class="text-break">@(listing.Size ?? "Not specified")</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd><span class="badge status-label @(listing.Status == ListingStatus.Held ? "status-label--reserved" : "status-label--available")">@statusLabel</span></dd>
            </div>
        </dl>

        <section class="item-reservation-panel" aria-labelledby="reservation-heading">
            <h2 id="reservation-heading">Reserve this item</h2>
            <p class="pickup-location">Pickup at Colman Hall</p>
            <p>@Model.ReservationAvailabilityMessage</p>
            @if (!Model.IsSignedIn)
            {
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Model.LoginReturnUrl"
                   class="btn btn-outline-primary">Sign in to reserve</a>
            }
            else if (!Model.IsEligibleStudent)
            {
                <p>An active Student account with a confirmed @@lawrence.edu email is required to reserve items.</p>
                <a asp-area="Identity" asp-page="/Account/ResendEmailConfirmation" asp-route-returnUrl="@Model.LoginReturnUrl">Request a confirmation email</a>
            }
            else if (Model.CanReserve)
            {
                <form method="post" asp-page="/Account/Reserve" asp-antiforgery="true">
                    <input type="hidden" name="ListingId" value="@listing.Id" />
                    <button type="submit" class="btn btn-primary">Reserve item</button>
                </form>
            }
        </section>

        <section class="item-description" aria-labelledby="description-heading">
            <h2 id="description-heading">Description</h2>
            <p class="text-break">@listing.Description</p>
        </section>
    </div>
</div>
</div>

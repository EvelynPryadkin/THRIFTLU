@using LUThrift.Web.Models
@using LUThrift.Web.Authorization
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var isReservations = string.IsNullOrEmpty(currentArea) && currentPage == "/Account/Reservations";
    var isRegister = currentArea == "Identity" && currentPage == "/Account/Register";
    var isLogin = currentArea == "Identity" && currentPage == "/Account/Login";
}

<ul class="navbar-nav account-navigation">
    @if (currentUser is not null)
    {
        @if (User.IsInRole(ApplicationRoles.Student))
        {
            <li class="nav-item">
                <a class="nav-link @(isReservations ? "active" : null)" aria-current="@(isReservations ? "page" : null)"
                   asp-area="" asp-page="/Account/Reservations">My reservations</a>
            </li>
        }
        <li class="nav-item">
            <form class="account-logout" method="post" asp-area="Identity" asp-page="/Account/Logout" asp-antiforgery="true">
                <button type="submit" class="nav-link btn btn-link">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link account-register @(isRegister ? "active" : null)" aria-current="@(isRegister ? "page" : null)"
               asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(isLogin ? "active" : null)" aria-current="@(isLogin ? "page" : null)"
               asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

@using LUThrift.Web.Models
@using LUThrift.Web.Authorization
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
}

<ul class="navbar-nav">
    @if (currentUser is not null)
    {
        @if (User.IsInRole(ApplicationRoles.Student))
        {
            <li class="nav-item">
                <a class="nav-link text-dark" asp-area="" asp-page="/Account/Reservations">My reservations</a>
            </li>
        }
        <li class="nav-item">
            <span class="navbar-text text-dark text-break">@currentUser.DisplayName</span>
        </li>
        <li class="nav-item">
            <form method="post" asp-area="Identity" asp-page="/Account/Logout" asp-antiforgery="true">
                <button type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">Login</a>
        </li>
    }
</ul>

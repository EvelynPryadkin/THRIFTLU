@page
@model LUThrift.Web.Pages.Account.ReservationsModel
@using LUThrift.Web.ViewModels
@{
    ViewData["Title"] = "My reservations";
}

<div class="account-reservations-page">
    <header class="page-heading">
        <p class="page-kicker">Your account</p>
        <h1>@ViewData["Title"]</h1>
        <p class="page-intro">Reservation times include the campus timezone and UTC offset. You can cancel an active reservation before its deadline.</p>
    </header>

    <div class="reservation-overview">
        <p id="active-reservation-count" class="mb-0">Active reservations: @Model.Overview.ActiveCount of @Model.MaximumActiveReservations</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ReservationMessage))
    {
        <div class="alert alert-info" role="status">@Model.ReservationMessage</div>
    }

    <section id="current-reservations" aria-labelledby="current-reservations-heading" class="reservation-section">
        <div class="reservation-section-heading">
            <h2 id="current-reservations-heading">Current reservations</h2>
        </div>
        @if (Model.Overview.Current.Count == 0)
        {
            <p class="empty-state">You have no current reservations.</p>
        }
        else
        {
            <div class="reservation-grid">
                @foreach (var reservation in Model.Overview.Current)
                {
                    <partial name="_ReservationCard" model="reservation" />
                }
            </div>
        }
    </section>

    <section id="reservation-history" aria-labelledby="reservation-history-heading" class="reservation-section reservation-section--history">
        <div class="reservation-section-heading">
            <h2 id="reservation-history-heading">Recent history</h2>
            <p>Your latest @ReservationOverview.RecentHistoryLimit past reservations, newest first. Item titles remain visible even when public details are no longer available.</p>
        </div>
        @if (Model.Overview.RecentHistory.Count == 0)
        {
            <p class="empty-state">No recent reservations yet.</p>
        }
        else
        {
            <div class="reservation-grid">
                @foreach (var reservation in Model.Overview.RecentHistory)
                {
                    <partial name="_ReservationCard" model="reservation" />
                }
            </div>
        }
    </section>

    <a asp-page="/Thrift/Index" class="btn btn-primary">Browse items</a>
</div>

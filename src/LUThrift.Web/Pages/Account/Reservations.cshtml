@page
@model LUThrift.Web.Pages.Account.ReservationsModel
@using System.Globalization
@{
    ViewData["Title"] = "My reservations";
}

<h1>@ViewData["Title"]</h1>
<p>Reservation deadlines are shown in UTC. You can cancel an active reservation before its deadline.</p>

@if (!string.IsNullOrWhiteSpace(Model.ReservationMessage))
{
    <div class="alert alert-info" role="status">@Model.ReservationMessage</div>
}

@if (Model.Reservations.Count == 0)
{
    <p>You have no reservations to show.</p>
}
else
{
    <div class="row row-cols-1 row-cols-lg-2 g-3">
        @foreach (var reservation in Model.Reservations)
        {
            var createdAtUtc = DateTime.SpecifyKind(reservation.CreatedAtUtc, DateTimeKind.Utc);
            var expiresAtUtc = DateTime.SpecifyKind(reservation.ExpiresAtUtc, DateTimeKind.Utc);
            <div class="col">
                <article class="card h-100" aria-labelledby="reservation-title-@reservation.Id">
                    <div class="card-body">
                        <h2 id="reservation-title-@reservation.Id" class="h5 text-break">@reservation.Title</h2>
                        <dl class="mb-0">
                            <dt>Status</dt>
                            <dd>@reservation.Status</dd>
                            <dt>Reserved (UTC)</dt>
                            <dd><time datetime="@createdAtUtc.ToString("O", CultureInfo.InvariantCulture)">@createdAtUtc.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</time></dd>
                            <dt>Deadline (UTC)</dt>
                            <dd><time datetime="@expiresAtUtc.ToString("O", CultureInfo.InvariantCulture)">@expiresAtUtc.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</time></dd>
                        </dl>
                        @if (reservation.CanCancel)
                        {
                            <form method="post" asp-page-handler="Cancel" asp-antiforgery="true" class="mt-3">
                                <input type="hidden" name="id" value="@reservation.Id" />
                                <button type="submit" class="btn btn-outline-secondary" aria-label="Cancel reservation for @reservation.Title">Cancel reservation</button>
                            </form>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}

<a asp-page="/Thrift/Index" class="d-inline-block mt-3">Browse items</a>

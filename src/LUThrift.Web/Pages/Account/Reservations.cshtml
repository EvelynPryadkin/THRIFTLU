@page
@model LUThrift.Web.Pages.Account.ReservationsModel
@using LUThrift.Web.ViewModels
@{
    ViewData["Title"] = "My reservations";
}

<h1>@ViewData["Title"]</h1>
<p id="active-reservation-count" class="lead">Active reservations: @Model.Overview.ActiveCount of @Model.MaximumActiveReservations</p>
<p>Reservation times include the campus timezone and UTC offset. You can cancel an active reservation before its deadline.</p>

@if (!string.IsNullOrWhiteSpace(Model.ReservationMessage))
{
    <div class="alert alert-info" role="status">@Model.ReservationMessage</div>
}

<section id="current-reservations" aria-labelledby="current-reservations-heading" class="mb-4">
    <h2 id="current-reservations-heading" class="h4">Current reservations</h2>
    @if (Model.Overview.Current.Count == 0)
    {
        <p>You have no current reservations.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 g-3">
            @foreach (var reservation in Model.Overview.Current)
            {
                <div class="col">
                    <partial name="_ReservationCard" model="reservation" />
                </div>
            }
        </div>
    }
</section>

<section id="reservation-history" aria-labelledby="reservation-history-heading">
    <h2 id="reservation-history-heading" class="h4">Recent history</h2>
    <p>Your latest @ReservationOverview.RecentHistoryLimit past reservations, newest first. Item titles remain visible even when public details are no longer available.</p>
    @if (Model.Overview.RecentHistory.Count == 0)
    {
        <p>No recent reservations yet.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-lg-2 g-3">
            @foreach (var reservation in Model.Overview.RecentHistory)
            {
                <div class="col">
                    <partial name="_ReservationCard" model="reservation" />
                </div>
            }
        </div>
    }
</section>

<a asp-page="/Thrift/Index" class="d-inline-block mt-3">Browse items</a>

@model LUThrift.Web.ViewModels.ReservationSummary
@using System.Globalization
@using LUThrift.Web.Models
@inject LUThrift.Web.Services.CampusTimeFormatter CampusTime
@{
    var createdAtUtc = DateTime.SpecifyKind(Model.CreatedAtUtc, DateTimeKind.Utc);
    var expiresAtUtc = DateTime.SpecifyKind(Model.ExpiresAtUtc, DateTimeKind.Utc);
    var statusClass = Model.Status switch
    {
        ReservationStatus.Active => "status-label--available",
        ReservationStatus.Fulfilled => "status-label--complete",
        _ => "status-label--muted"
    };
}

<article class="card h-100 reservation-card @(Model.CanCancel ? "reservation-card--current" : "reservation-card--history")" aria-labelledby="reservation-title-@Model.Id">
    <div class="card-body">
        <h3 id="reservation-title-@Model.Id" class="reservation-card-heading h5 text-break">@Model.Title</h3>
        <dl class="reservation-metadata mb-0">
            <div>
                <dt>Status</dt>
                <dd><span class="status-label @statusClass">@Model.Status</span></dd>
            </div>
            @if (Model.Status == ReservationStatus.Canceled && Model.CancellationMessage is { } reason)
            {
                <div>
                    <dt>Cancellation reason</dt>
                    <dd class="text-break">@reason</dd>
                </div>
            }
            <div>
                <dt>Reserved</dt>
                <dd><time datetime="@createdAtUtc.ToString("O", CultureInfo.InvariantCulture)">@(await CampusTime.FormatAsync(createdAtUtc, ViewContext.HttpContext.RequestAborted))</time></dd>
            </div>
            <div class="reservation-deadline">
                <dt>Deadline</dt>
                <dd><time datetime="@expiresAtUtc.ToString("O", CultureInfo.InvariantCulture)">@(await CampusTime.FormatAsync(expiresAtUtc, ViewContext.HttpContext.RequestAborted))</time></dd>
            </div>
            @if (Model.Status == ReservationStatus.Fulfilled)
            {
                <div>
                    <dt>Collected</dt>
                    @if (Model.FulfilledAtUtc is { } fulfilledAtUtc)
                    {
                        <dd class="text-break"><time datetime="@DateTime.SpecifyKind(fulfilledAtUtc, DateTimeKind.Utc).ToString("O", CultureInfo.InvariantCulture)">@(await CampusTime.FormatAsync(fulfilledAtUtc, ViewContext.HttpContext.RequestAborted))</time></dd>
                    }
                    else
                    {
                        <dd>Collection time was not recorded.</dd>
                    }
                </div>
            }
        </dl>
        @if (Model.CanCancel)
        {
            <form method="post" asp-page="/Account/Reservations" asp-page-handler="Cancel" asp-antiforgery="true" class="reservation-actions">
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-outline-primary" aria-label="Cancel reservation for @Model.Title">Cancel reservation</button>
            </form>
        }
    </div>
</article>
